# Clerk (band leader sign-in) — from dashboard.clerk.com → API keys.
# Without both, sign-in is off: local dev opens the dashboard as the seeded
# demo leader, and production keeps the dashboard closed.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=      # pk_test_… / pk_live_…
CLERK_SECRET_KEY=                       # sk_test_… / sk_live_… (server-only)

# Optional: a Clerk user ID (user_…) or verified email. When that user signs in,
# they take over every band created before Clerk sign-in existed.
CLAIM_EXISTING_BANDS_FOR=

# Database (direct connection for Drizzle migrations + queries)
DATABASE_URL=                           # Postgres connection string

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
